generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String // admin, user, devops
  createdAt DateTime @default(now())

  // Explicit relation name
  ownedProjects Project[]    @relation("UserProjects")
  permissions   Permission[]
}

model Project {
  id             String           @id @default(uuid())
  name           String
  ownerId        String
  owner          User             @relation(name: "UserProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  workflows      Workflow[]
  pipelines      Pipeline[]
  infrastructure Infrastructure[]
  createdAt      DateTime         @default(now())
  permissions    Permission[]
}

model Workflow {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  status    String   @default("pending") // pending, running, completed
  logs      Log[]
  createdAt DateTime @default(now())
}

model Pipeline {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Infrastructure {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  provider   String // AWS, GCP, Azure
  resourceId String
  status     String   @default("active")
  createdAt  DateTime @default(now())
}

model Log {
  id         String    @id @default(uuid())
  workflowId String?
  workflow   Workflow? @relation(fields: [workflowId], references: [id])
  message    String
  createdAt  DateTime  @default(now())
}

model Permission {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  role      String // read, write, admin
}
