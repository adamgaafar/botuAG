# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://myuser:root@localhost:5432/botu"

JWT_SECRET=your_jwt_secret_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# AWS SDK Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=your_aws_region_here

# GCP SDK Configuration
GCP_CREDENTIALS=your_gcp_credentials_json_here

# Azure SDK Configuration
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id_here

# Prometheus/Grafana Configuration
PROMETHEUS_URL=your_prometheus_url_here
GRAFANA_URL=your_grafana_url_here

# Slack/Teams Integration
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here

UPLOAD_PATH=./uploads
EXTRACT_PATH=./extracted
CLONE_PATH=./cloned-repos

PORT=3000

VERCEL_TOKEN=your_vercel_token_here
